{
    "name": "assinafy",
    "packageManager": "bun@1.4.4",
    "version": "1.0.4",
    "description": "TypeScript SDK for Assinafy API - Digital signature platform",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown",
        "test": "bun test",
        "lint": "oxlint src",
        "lint:fix": "oxlint src --fix",
        "prepublishOnly": "bun run build",
        "release": "bun run build && bun test && bun lint && bun typecheck && bun run build && npm publish",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "assinafy",
        "assinatura-eletronica",
        "assinatura",
        "eletronica",
        "api-client",
        "typescript"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gusnips/assinafy.git"
    },
    "bugs": {
        "url": "https://github.com/gusnips/assinafy/issues"
    },
    "homepage": "https://github.com/gusnips/assinafy#readme",
    "devDependencies": {
        "@gusnips/oxlint": "^0.2.0",
        "@types/bun": "latest",
        "oxlint": "1.93.0",
        "tsdown": "0.23.7",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "axios": "^1.6.0"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}